---
import { profile, projectsData } from '../../../data/profileData';

const project = projectsData.find((item) => item.title === 'Audio-Language Models for Voice Activity Detection');
if (!project) throw new Error('Audio-Language Models for Voice Activity Detection project not found');

const siteUrl = profile.links.web.replace(/\/$/, '');
const canonical = `${siteUrl}/work/audio-language-vad/`;
const repoUrl = project.links.find((link) => link.label === 'Code')?.href ?? 'https://github.com/gbibbo/qwen-vad-lora';
const socialImage = `${siteUrl}${project.image}`;
const pageTitle = 'Robust VAD with Audio-Language Models · Gabriel Bibbó';
const description = 'Technical case study: Qwen2-Audio, Qwen3-Omni, LoRA and OPRO for robust voice activity detection under duration, noise, reverberation and spectral degradations.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: 'en',
  dateModified: profile.updated,
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: profile.name,
    url: `${siteUrl}/`,
    sameAs: [profile.links.linkedin, profile.links.github, profile.links.scholar, profile.links.orcid],
  },
  mainEntity: {
    '@type': 'CreativeWork',
    name: project.title,
    description: project.description,
    creator: { '@id': `${siteUrl}/#person` },
    keywords: project.tags,
    url: canonical,
    sameAs: repoUrl,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="author" content={profile.name} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{pageTitle}</title>
    <style>
      :root{font-family:Arial,sans-serif;color:#171a1c;background:#f3f4ef}*{box-sizing:border-box}body{margin:0;background:#f3f4ef;color:#171a1c}a{color:inherit;text-underline-offset:3px}.shell{width:min(1040px,calc(100% - 40px));margin:0 auto}.hero{padding:54px 0 44px;background:#1c1f24;color:#f5f6f2}.topline{display:flex;justify-content:space-between;gap:20px;font-size:13px;color:#c7cbc7}.eyebrow{margin:42px 0 12px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#c7cbc7}.hero h1{font:500 clamp(38px,6vw,68px)/1 Georgia,serif;max-width:900px;margin:0}.hero p{max-width:820px;margin:22px 0 0;font-size:19px;line-height:1.55;color:#dde0dc}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:34px;border-top:1px solid #4b5051;border-bottom:1px solid #4b5051}.fact{padding:18px 18px 18px 0}.fact+.fact{padding-left:18px;border-left:1px solid #4b5051}.fact strong{display:block;font:500 26px/1 Georgia,serif;margin-bottom:7px}.fact span{font-size:12px;color:#bfc4c0}.section{padding:48px 0;border-bottom:1px solid #c8ccc7}.section h2{font:500 31px/1.15 Georgia,serif;margin:0 0 24px}.section h3{font-size:17px;margin:0 0 8px}.section p,.section li{line-height:1.6;color:#4e5451}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.benchmark{width:100%;border-collapse:collapse;font-size:14px}.benchmark th,.benchmark td{text-align:left;padding:12px 10px;border-bottom:1px solid #c8ccc7}.benchmark th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#666d69}.benchmark td:not(:first-child),.benchmark th:not(:first-child){text-align:right}.figure{margin:30px 0 0}.figure img{display:block;width:100%;max-width:850px;height:auto;background:#fff;border:1px solid #d1d4d0}.figure figcaption{margin-top:10px;font-size:12px;color:#666d69}.evidence{display:grid;grid-template-columns:160px 1fr;gap:24px;padding:18px 0;border-top:1px solid #c8ccc7}.evidence:last-child{border-bottom:1px solid #c8ccc7}.evidence .label{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:#6b716e}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.tag{font-size:12px;border:1px solid #bfc4bf;padding:6px 8px}.footer{padding:38px 0 52px;display:flex;justify-content:space-between;gap:20px;font-size:13px}@media(max-width:760px){.shell{width:min(100% - 28px,1040px)}.hero{padding-top:36px}.topline{flex-direction:column}.facts,.grid{grid-template-columns:1fr 1fr}.fact:nth-child(3){border-left:0}.evidence{grid-template-columns:1fr;gap:6px}}@media(max-width:480px){.facts,.grid{grid-template-columns:1fr}.fact+.fact{padding-left:0;border-left:0;border-top:1px solid #4b5051}.fact:nth-child(3){border-top:1px solid #4b5051}}
    </style>
  </head>
  <body>
    <header class="hero">
      <div class="shell">
        <div class="topline"><a href="/">Gabriel Bibbó</a><a href={repoUrl} target="_blank" rel="noreferrer">GitHub repository</a></div>
        <div class="eyebrow">Technical case study · Audio ML · VAD · 2025-2026</div>
        <h1>Robust voice activity detection with audio-language models</h1>
        <p>This project tests whether adapting a smaller audio-language model can beat a larger frozen model when speech evidence is short, noisy, reverberant, or spectrally filtered.</p>
        <div class="facts" aria-label="Headline project results">
          <div class="fact"><strong>93.3%</strong><span>best balanced accuracy</span></div>
          <div class="fact"><strong>21,340</strong><span>degraded test clips</span></div>
          <div class="fact"><strong>96 ms</strong><span>DT90 for LoRA + OPRO-Template</span></div>
          <div class="fact"><strong>4 axes</strong><span>duration, noise, reverb, filtering</span></div>
        </div>
      </div>
    </header>

    <main>
      <section class="section">
        <div class="shell">
          <h2>Problem</h2>
          <p>Voice activity detection is usually evaluated on relatively clean, well-segmented audio. This benchmark instead measures how robust speech/non-speech decisions remain when acoustic evidence is deliberately degraded along controlled psychometric dimensions.</p>
          <div class="grid">
            <article><h3>Segment duration</h3><p>20, 40, 60, 80, 100, 200, 500 and 1000 ms.</p></article>
            <article><h3>Additive noise</h3><p>SNR levels from -10 dB to +20 dB.</p></article>
            <article><h3>Reverberation</h3><p>RT60 values of 0.0, 0.3, 1.0 and 2.5 seconds.</p></article>
            <article><h3>Spectral filtering</h3><p>None, bandpass, lowpass and highpass conditions.</p></article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <h2>Systems compared</h2>
          <table class="benchmark">
            <thead><tr><th>System</th><th>Balanced accuracy</th><th>Speech recall</th><th>Non-speech recall</th></tr></thead>
            <tbody>
              <tr><td>Qwen2-Audio-7B + OPRO-LLM</td><td>82.6%</td><td>74.7%</td><td>90.6%</td></tr>
              <tr><td><strong>Qwen2-Audio-7B + LoRA + OPRO-Template</strong></td><td><strong>93.3%</strong></td><td><strong>92.8%</strong></td><td><strong>93.8%</strong></td></tr>
              <tr><td>Qwen3-Omni-30B frozen + hand prompt</td><td>91.1%</td><td>87.4%</td><td>94.7%</td></tr>
              <tr><td>Silero VAD</td><td>88.9%</td><td>78.8%</td><td>99.1%</td></tr>
            </tbody>
          </table>
          <p>The strongest balanced result came from the adapted 7B model rather than the larger frozen 30B model. Silero remained the most conservative system, with very high non-speech recall but lower speech recall.</p>
          <figure class="figure">
            <img src={project.image} alt="Overall balanced accuracy comparison for the audio-language model VAD systems" loading="lazy" />
            <figcaption>Overall balanced-accuracy comparison from the project evaluation artifacts.</figcaption>
          </figure>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <h2>What I built</h2>
          <div class="evidence"><div class="label">Benchmark</div><div>Controlled degradation bank spanning duration, SNR, reverberation and spectral filtering.</div></div>
          <div class="evidence"><div class="label">Adaptation</div><div>LoRA fine-tuning for Qwen2-Audio-7B, including 4-bit quantization and PEFT-based training.</div></div>
          <div class="evidence"><div class="label">Prompt search</div><div>Hand prompts, OPRO-LLM and OPRO-Template treated as experimental factors. The prompt-optimization stage contains 435 evaluations over 71 unique prompts.</div></div>
          <div class="evidence"><div class="label">Evaluation</div><div>Balanced accuracy, class recall, per-condition breakdowns, bootstrap confidence intervals, McNemar tests and multi-seed analyses.</div></div>
          <div class="evidence"><div class="label">Artifacts</div><div>JSON metrics, CSV predictions, statistical reports, LaTeX tables, figures, audit reports and Slurm job support.</div></div>
          <div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}<span class="tag">PEFT</span><span class="tag">4-bit quantization</span><span class="tag">Hugging Face Transformers</span><span class="tag">Slurm</span></div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <h2>Robustness findings</h2>
          <div class="grid">
            <article><h3>Short evidence</h3><p>LoRA + OPRO-Template reaches DT90 = 96 ms, approximately the amount of audio required to reach 90% balanced accuracy.</p></article>
            <article><h3>Noise</h3><p>LoRA adaptation produces a more stable robustness profile under additive noise than prompt optimization alone.</p></article>
            <article><h3>Failure modes</h3><p>Human and animal vocalizations are important confounders. Laughing, coughing and crying-baby clips remain difficult non-speech cases.</p></article>
            <article><h3>Model size</h3><p>The experiment provides a concrete counterexample to the assumption that the largest frozen audio-language model necessarily gives the strongest VAD result.</p></article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="shell">
          <h2>Evidence and reproducibility</h2>
          <p>The public repository contains the experiment configuration, evaluation scripts, fine-tuning code, prompt-optimization scripts, consolidated metrics, statistical analyses, figures, LaTeX tables and audit reports used to reconstruct the headline results.</p>
          <p><a href={repoUrl} target="_blank" rel="noreferrer"><strong>Inspect the public repository on GitHub</strong></a></p>
        </div>
      </section>
    </main>

    <footer class="footer shell"><span><a href="/">Full professional profile</a></span><span><a href={`mailto:${profile.email}`}>{profile.email}</a></span></footer>
  </body>
</html>
