---
import '../styles/editorial-v2.css';
import ProfileAssistantV2 from './ProfileAssistantV2';
import {
  coursesData,
  educationData,
  experienceData,
  profile,
  projectsData,
  publicationsData,
  stackGroups,
} from '../data/profileData';

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const siteUrl = profile.links.web.replace(/\/$/, '');
const canonical = isEs ? `${siteUrl}/es/` : `${siteUrl}/`;
const socialImage = `${siteUrl}/homepage_files/profile.jpg`;
const cvHref = isEs ? '/es/cv/' : '/cv/';

const selectedTitles = [
  'Audio-Language Models for Voice Activity Detection',
  'Sounds of Home Dataset',
  'Speech Removal Framework',
  'Harmonic EDM Mixing Compatibility',
  'ASR Enhancement Platform',
  'Traktor ML',
];
const selectedProjects = selectedTitles.map((title) => projectsData.find((item) => item.title === title)).filter(Boolean);
const otherProjects = projectsData.filter((item) => !selectedTitles.includes(item.title));
const publicationYears = [...new Set(publicationsData.map((item) => item.year))];
const [updatedYear, updatedMonth, updatedDay] = profile.updated.split('-');
const monthEn = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(updatedMonth) - 1];
const monthEs = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'][Number(updatedMonth) - 1];
const updatedDate = `${Number(updatedDay)} ${isEs ? monthEs : monthEn} ${updatedYear}`;

const copy = isEs
  ? {
      role: profile.roleEs,
      technicalLine: 'Audio ML · DSP · machine listening · privacidad acústica · audio en tiempo real · MIR',
      engineeringSince: 'Ingeniería desde 2016',
      researchSince: 'Investigación en audio desde 2022',
      publicationsCount: `${publicationsData.length} publicaciones y trabajos`,
      eu: 'Autorización laboral UE',
      updated: 'Actualizado',
      questions: 'Preguntas de trabajo',
      questionItems: [
        ['¿Qué significa realmente que un modelo de audio sea robusto?', 'Audio corto, ruidoso, reverberante y filtrado; hardware real.'],
        ['¿Cuánta información acústica podemos conservar sin conservar habla?', 'Datasets y flujos de publicación con privacidad incorporada.'],
        ['¿Cómo hacemos que machine listening sea útil para músicos?', 'Mezcla armónica, organización de librerías y análisis en tiempo real.'],
      ],
      selected: 'Trabajo seleccionado',
      selectedLine: 'Robustez, privacidad, machine listening y tecnología musical.',
      experience: 'Experiencia',
      education: 'Educación',
      publications: 'Publicaciones',
      otherProjects: 'Otros proyectos',
      courses: 'Cursos y certificaciones',
      skills: 'Stack técnico',
      languages: 'Idiomas',
      affiliations: 'Membresías e investigación financiada',
      contact: 'Contacto',
      pageTitle: 'Gabriel Bibbó · Audio ML research and engineering',
      metaDescription: profile.headlineEs,
    }
  : {
      role: profile.role,
      technicalLine: 'Audio ML · DSP · machine listening · acoustic privacy · real-time audio · MIR',
      engineeringSince: 'Engineering since 2016',
      researchSince: 'Audio research since 2022',
      publicationsCount: `${publicationsData.length} publications & works`,
      eu: 'EU work authorization',
      updated: 'Updated',
      questions: 'Working questions',
      questionItems: [
        ['What does it really mean for an audio model to be robust?', 'Short, noisy, reverberant, filtered audio; real hardware.'],
        ['How much useful acoustic information can we retain without retaining speech?', 'Privacy-preserving datasets and release pipelines.'],
        ['How do we make machine listening useful to musicians?', 'Harmonic mixing, library organisation, real-time analysis.'],
      ],
      selected: 'Selected work',
      selectedLine: 'Robustness, privacy, machine listening, and music technology.',
      experience: 'Experience',
      education: 'Education',
      publications: 'Publications',
      otherProjects: 'Other projects',
      courses: 'Courses & certifications',
      skills: 'Technical skills',
      languages: 'Languages',
      affiliations: 'Memberships & funded research',
      contact: 'Contact',
      pageTitle: 'Gabriel Bibbó · Audio ML research and engineering',
      metaDescription: profile.headline,
    };

const linkLabel = (label) => {
  if (!isEs) return label;
  return ({
    Code: 'Código', Paper: 'Artículo', DOI: 'DOI', Demo: 'Demo', Video: 'Video',
    'Official site': 'Sitio', 'Dataset site': 'Dataset', Identifier: 'Registro', Link: 'Enlace',
    Repository: 'Repositorio', Publication: 'Publicación', Preprint: 'Preprint', ISBN: 'ISBN',
    'Open research': 'Open research', 'AES program': 'Programa AES', Program: 'Programa',
  }[label] ?? label);
};

const projectTitle = (project) => isEs ? project.titleEs : project.title;
const projectCategory = (project) => isEs ? project.categoryEs : project.category;
const projectDescription = (project) => isEs ? project.descriptionEs : project.description;
const projectCaseStudyRoutes = {
  'Audio-Language Models for Voice Activity Detection': '/work/audio-language-vad/',
};
const projectPrimaryHref = (project) => project.links?.[0]?.href ?? project.image;
const projectImageHref = (project) => projectCaseStudyRoutes[project.title] ?? projectPrimaryHref(project);
const projectImageIsExternal = (project) => !projectCaseStudyRoutes[project.title];
const publicationPrimaryHref = (publication) => publication.links?.[0]?.href ?? '#';
const availability = isEs ? profile.availabilityEs : profile.availability;
const languageText = profile.languages.map((item) => `${isEs ? item.nameEs : item.nameEn} ${isEs ? item.levelEs : item.levelEn}`).join(' · ');

const experienceVisual = (item) => {
  if (item.org === 'Edge Audio Labs') return { image: '/homepage_files/edge-audio-labs.svg', alt: 'Edge Audio Labs', href: item.orgUrl };
  if (item.org.includes('University of Surrey')) return { image: '/homepage_files/surrey.jpg', alt: 'University of Surrey', href: 'https://www.surrey.ac.uk/' };
  if (item.org === 'Webhelp') return { image: '/homepage_files/logo-google-official.svg', alt: 'Google', href: 'https://workspace.google.com/' };
  if (item.org === 'KPMG') return { image: '/homepage_files/logo-kpmg-official.svg', alt: 'KPMG', href: item.orgUrl };
  if (item.org === 'Ikatu') return { image: '/homepage_files/logo-ikatu-official.svg', alt: 'Ikatu', href: item.orgUrl };
  return null;
};

const educationVisual = (item) => {
  if (item.institution.includes('Pompeu Fabra')) return { image: '/homepage_files/UPFMTG.png', alt: 'Universitat Pompeu Fabra Music Technology Group', href: 'https://www.upf.edu/web/mtg' };
  if (item.institution.includes('Universidad de la República')) return { image: '/homepage_files/FING.png', alt: 'Facultad de Ingeniería, Universidad de la República', href: 'https://www.fing.edu.uy/' };
  return null;
};

const publicationImages = {
  'Privacy for Audio AI: Risks, Challenges, and Emerging Solutions in the Era of Audio AI [Panel discussion]': '/homepage_files/privacy_AES_panel.png',
  'Speech Removal Framework for Privacy-preserving Audio Recordings': '/homepage_files/waspaa_2025_vad_demo.png',
  'Room Acoustics and Microphone Characteristics Show Systematic Impact on Sound Event Recognition': '/homepage_files/internoise_2025_room_acoustics_mics.png',
  'Integrating IP broadcasting with audio tags: Workflow and challenges': '/homepage_files/ip_broadcasting_audio_tags_workflow.png',
  "Soundscape Experience Mapping: A Deep Listening Approach for Eliciting Older Adults' Perceptions of Indoor Soundscapes": '/homepage_files/euronoise_2025_soundscape_experience_mapping.png',
  'Personalized Live Sound Recognition Using Efficient PANNs [Show and Tell]': '/homepage_files/icassp_2025_pann_recognition.png',
  'Environmental sound classification on an embedded hardware platform': '/homepage_files/internoise_2024_embedded_esc.png',
  'The Sounds of Home: A Speech-Removed Residential Audio Dataset for Sound Event Detection': '/homepage_files/chime_2024_sounds_of_home.png',
  'Soundscape Personalisation at Work: Designing AI-Enabled Sound Technologies for the Workplace': '/homepage_files/smc_2024_soundscape_workplace.png',
  'Recognise and Notify Sound Events Using a Raspberry PI Based Standalone Device [Demo]': '/homepage_files/waspaa_2023_raspberry_pi_sed.png',
  'A New Compatibility Measure for Harmonic EDM Mixing': '/homepage_files/icwe_2022_harmonic_mixing.png',
  'Towards a New Compatibility Measure for Harmonic EDM Mixing': '/homepage_files/thesis_2021_harmonic_mixing.png',
  'Autonomous Mobile Robots Communicated by Software Defined Radio': '/homepage_files/thesis_2017_mobile_robots_sdr.png',
};
---

<!doctype html>
<html lang={isEs ? 'es' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.metaDescription} />
    <meta name="theme-color" content="#1c1f24" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <link rel="icon" type="image/png" href="/homepage_files/favicon.png" />
    <meta property="og:title" content={copy.pageTitle} />
    <meta property="og:description" content={copy.metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.pageTitle} />
    <meta name="twitter:description" content={copy.metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <title>{copy.pageTitle}</title>
  </head>
  <body>
    <main>
      <section class="tone tone-1" id="home">
        <div class="v3-shell hero-shell">
          <div class="hero-copy">
            <div class="topline">
              <span>{profile.location}</span>
              <span class="language-switcher"><a href="/" class={!isEs ? 'active' : ''}>EN</a><span>/</span><a href="/es/" class={isEs ? 'active' : ''}>ES</a></span>
            </div>
            <h1>{profile.name}</h1>
            <p class="hero-role">{copy.role}</p>
            <p class="technical-line">{copy.technicalLine}</p>
            <div class="signal-row" aria-label="Profile facts">
              <span>{copy.engineeringSince}</span><span>{copy.researchSince}</span><span>{copy.publicationsCount}</span><span>{copy.eu}</span>
            </div>
            <div class="link-row hero-links">
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
              <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
              <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
              <a href={profile.links.scholar} target="_blank" rel="noreferrer">Scholar</a>
              <a href={profile.links.orcid} target="_blank" rel="noreferrer">ORCID</a>
              <a href={cvHref}>CV</a>
            </div>
            <p class="updated">{copy.updated} {updatedDate}</p>
          </div>
          <figure class="hero-photo"><img src="/homepage_files/profile.jpg" alt="Gabriel Bibbó" /></figure>
        </div>
      </section>

      <div class="tone-transition transition-12" aria-hidden="true"></div>

      <section class="tone tone-2" id="research-work">
        <div class="v3-shell content-stack">
          <div class="content-block" id="questions">
            <h2>{copy.questions}</h2>
            <div class="question-grid">
              {copy.questionItems.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}
            </div>
          </div>

          <div class="content-block" id="work">
            <h2>{copy.selected}</h2>
            <div class="block-body">
              <p class="section-line">{copy.selectedLine}</p>
              <div class="selected-list">
                {selectedProjects.map((project) => (
                  <article class="selected-item">
                    <a class={`selected-media selected-media-${project.imageFit ?? 'contain'}`} href={projectImageHref(project)} target={projectImageIsExternal(project) ? '_blank' : undefined} rel={projectImageIsExternal(project) ? 'noreferrer' : undefined} aria-label={projectTitle(project)}><img src={project.image} alt={projectTitle(project)} loading="lazy" style={`object-position: ${project.imagePosition ?? 'center center'};`} /></a>
                    <div class="selected-copy">
                      <div class="meta-line"><span>{projectCategory(project)}</span><span>{project.years}</span></div>
                      <h3>{projectTitle(project)}</h3>
                      <p class="project-description">{projectDescription(project)}</p>
                      <p class="tag-line">{project.tags.join(' · ')}</p>
                      {project.links.length > 0 && <div class="link-row">{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{linkLabel(link.label)}</a>)}</div>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="tone-transition transition-23" aria-hidden="true"></div>

      <section class="tone tone-3" id="experience-education">
        <div class="v3-shell content-stack">
          <div class="content-block" id="experience">
            <h2>{copy.experience}</h2>
            <div class="experience-list">
              {experienceData.map((item) => { const visual = experienceVisual(item); return (
                <article class="experience-item">
                  <div class="date-col">{item.dates}</div>
                  {visual && <a class="entity-thumb experience-thumb" href={visual.href} target="_blank" rel="noreferrer"><img src={visual.image} alt={visual.alt} loading="lazy" /></a>}
                  <div class="entity-copy">
                    <h3>{item.role}</h3>
                    <p class="org-line"><a href={item.orgUrl} target="_blank" rel="noreferrer">{item.org}</a> · {item.location}{item.mode ? ` · ${item.mode}` : ''}</p>
                    <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
                  </div>
                </article>
              ); })}
            </div>
          </div>

          <div class="content-block" id="education">
            <h2>{copy.education}</h2>
            <div class="education-list">
              {educationData.map((item) => { const visual = educationVisual(item); return (
                <article class={`education-item ${visual ? '' : 'no-thumb'}`}>
                  <div class="date-col">{item.dates}</div>
                  {visual && <a class="entity-thumb education-thumb" href={visual.href} target="_blank" rel="noreferrer"><img src={visual.image} alt={visual.alt} loading="lazy" /></a>}
                  <div class="entity-copy">
                    <h3>{item.degree}</h3>
                    <p class="org-line">{visual ? <a href={visual.href} target="_blank" rel="noreferrer">{item.institution}</a> : item.institution} · {item.location}</p>
                    <p>{[item.credits, item.focus].filter(Boolean).join(' · ')}</p>
                    {item.details && <p>{item.details}</p>}
                  </div>
                </article>
              ); })}
            </div>
          </div>
        </div>
      </section>

      <div class="tone-transition transition-34" aria-hidden="true"></div>

      <section class="tone tone-4" id="rest">
        <div class="v3-shell content-stack">
          <div class="content-block" id="publications">
            <h2>{copy.publications}</h2>
            <div class="publication-groups">
              {publicationYears.map((year) => (
                <section class="publication-year">
                  <h3>{year}</h3>
                  <ol>
                    {publicationsData.filter((publication) => publication.year === year).map((publication) => (
                      <li class="publication-item">
                        {publicationImages[publication.title] && <a class="publication-thumb" href={publicationPrimaryHref(publication)} target="_blank" rel="noreferrer"><img src={publicationImages[publication.title]} alt={publication.title} loading="lazy" /></a>}
                        <div>
                          <h4>{publication.title}</h4>
                          <p>{publication.authors.join('; ')}</p>
                          <p><em>{publication.venue}</em></p>
                          {publication.links.length > 0 && <div class="link-row">{publication.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{linkLabel(link.label)}</a>)}</div>}
                        </div>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </div>

          <div class="content-block" id="projects">
            <h2>{copy.otherProjects}</h2>
            <div class="plain-project-list">
              {otherProjects.map((project) => (
                <article class="plain-project-item">
                  <a class={`project-thumb project-thumb-${project.imageFit ?? 'contain'}`} href={projectImageHref(project)} target={projectImageIsExternal(project) ? '_blank' : undefined} rel={projectImageIsExternal(project) ? 'noreferrer' : undefined}><img src={project.image} alt={projectTitle(project)} loading="lazy" style={`object-position: ${project.imagePosition ?? 'center center'};`} /></a>
                  <div>
                    <div class="meta-line"><span>{projectCategory(project)}</span><span>{project.years}</span></div>
                    <h3>{projectTitle(project)}</h3>
                    <p>{projectDescription(project)}</p>
                    <p class="tag-line">{project.tags.join(' · ')}</p>
                    {project.links.length > 0 && <div class="link-row">{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{linkLabel(link.label)}</a>)}</div>}
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="compact-grid">
            <section class="content-block compact-block" id="courses">
              <h2>{copy.courses}</h2>
              <div class="compact-list">
                {coursesData.map((item) => <article><span>{item.year}</span><div><h3>{item.title}</h3><p>{[item.provider, item.status].filter(Boolean).join(' · ')}</p>{item.details && <p>{item.details}</p>}</div></article>)}
              </div>
            </section>

            <section class="content-block compact-block" id="skills">
              <h2>{copy.skills}</h2>
              <div class="skill-list">
                {stackGroups.map((group) => <article><h3>{group.name}</h3><p>{group.items.join(' · ')}</p></article>)}
              </div>
            </section>
          </div>

          <div class="compact-grid final-grid">
            <section class="content-block compact-block">
              <h2>{copy.languages}</h2>
              <p>{languageText}</p>
            </section>
            <section class="content-block compact-block">
              <h2>{copy.affiliations}</h2>
              <p>{profile.memberships.map((item) => `${item.name} (${item.period})`).join(' · ')}</p>
              <p>{profile.fundedResearch.map((item) => `${item.name} · ${item.context}`).join(' · ')}</p>
            </section>
          </div>

          <div class="content-block contact-block" id="contact">
            <h2>{copy.contact}</h2>
            <div>
              <p>{availability}</p>
              <div class="link-row contact-links">
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
                <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
                <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
                <a href={profile.links.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
                <a href={profile.links.orcid} target="_blank" rel="noreferrer">ORCID</a>
                <a href={cvHref}>CV</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <ProfileAssistantV2 client:load lang={isEs ? 'es' : 'en'} />
  </body>
</html>