---
import { profile } from '../data/profileData';

const {
  canonical,
  externalUrl,
  externalLabel = 'Source',
  socialImage,
  pageTitle,
  description,
  schema,
  eyebrow,
  heading,
  intro,
  facts = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="author" content={profile.name} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{pageTitle}</title>
    <style is:global>
      :root{font-family:Arial,sans-serif;color:#171a1c;background:#f3f4ef}*{box-sizing:border-box}body{margin:0;background:#f3f4ef;color:#171a1c}a{color:inherit;text-underline-offset:3px}.shell{width:min(1040px,calc(100% - 40px));margin:0 auto}.hero{padding:54px 0 44px;background:#1c1f24;color:#f5f6f2}.topline{display:flex;justify-content:space-between;gap:20px;font-size:13px;color:#c7cbc7}.eyebrow{margin:42px 0 12px;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#c7cbc7}.hero h1{font:500 clamp(38px,6vw,68px)/1 Georgia,serif;max-width:900px;margin:0}.hero p{max-width:820px;margin:22px 0 0;font-size:19px;line-height:1.55;color:#dde0dc}.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:34px;border-top:1px solid #4b5051;border-bottom:1px solid #4b5051}.fact{padding:18px 18px 18px 0}.fact+.fact{padding-left:18px;border-left:1px solid #4b5051}.fact strong{display:block;font:500 26px/1 Georgia,serif;margin-bottom:7px}.fact span{font-size:12px;color:#bfc4c0}.section{padding:48px 0;border-bottom:1px solid #c8ccc7}.section h2{font:500 31px/1.15 Georgia,serif;margin:0 0 24px}.section h3{font-size:17px;margin:0 0 8px}.section p,.section li{line-height:1.6;color:#4e5451}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.benchmark{width:100%;border-collapse:collapse;font-size:14px}.benchmark th,.benchmark td{text-align:left;padding:12px 10px;border-bottom:1px solid #c8ccc7}.benchmark th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#666d69}.benchmark td:not(:first-child),.benchmark th:not(:first-child){text-align:right}.figure{margin:30px 0 0}.figure-frame{display:flex;align-items:center;justify-content:center;width:min(100%,850px);aspect-ratio:16/9;padding:20px;background:#fff;border:1px solid #d1d4d0;overflow:hidden}.figure-frame img{display:block;width:100%;height:100%;object-fit:contain}.figure figcaption{margin-top:10px;font-size:12px;color:#666d69}.evidence{display:grid;grid-template-columns:160px 1fr;gap:24px;padding:18px 0;border-top:1px solid #c8ccc7}.evidence:last-child{border-bottom:1px solid #c8ccc7}.evidence .label{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:#6b716e}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.tag{font-size:12px;border:1px solid #bfc4bf;padding:6px 8px}.footer{padding:38px 0 52px;display:flex;justify-content:space-between;gap:20px;font-size:13px}@media(max-width:760px){.shell{width:min(100% - 28px,1040px)}.hero{padding-top:36px}.topline{flex-direction:column}.facts,.grid{grid-template-columns:1fr 1fr}.fact:nth-child(3){border-left:0}.evidence{grid-template-columns:1fr;gap:6px}.figure-frame{padding:14px}}@media(max-width:480px){.facts,.grid{grid-template-columns:1fr}.fact+.fact{padding-left:0;border-left:0;border-top:1px solid #4b5051}.fact:nth-child(3){border-top:1px solid #4b5051}}
    </style>
  </head>
  <body>
    <header class="hero">
      <div class="shell">
        <div class="topline"><a href="/">Gabriel Bibbó</a><a href={externalUrl} target="_blank" rel="noreferrer">{externalLabel}</a></div>
        <div class="eyebrow">{eyebrow}</div>
        <h1>{heading}</h1>
        <p>{intro}</p>
        <div class="facts" aria-label="Headline project results">
          {facts.map((fact) => <div class="fact"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer shell"><span><a href="/">Full professional profile</a></span><span><a href={`mailto:${profile.email}`}>{profile.email}</a></span></footer>
  </body>
</html>
